# Application Configuration
APP_NAME=GiveNaija API
APP_ENV=development
PORT=8000
DEBUG=True

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Connections (Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/givenaija
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/givenaija_test

# Redis Caching & Rate Limiting URL
REDIS_URL=redis://localhost:6379/0

# Payment Provider Webhook Signature Verification
WEBHOOK_SECRET=mysecret

# Google Cloud Firestore (Feed / Real-time activity)
FIRESTORE_PROJECT_ID=givenaija-dev

# Rate Limiting Controls
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# Scheduled Background Job API Key
CRON_API_KEY=give-naija-cron-secret-api-key
